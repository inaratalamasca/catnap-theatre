{
  "manifest_version": 3,
  "name": "Catnap Theatre + Inbox — Development",
  "version": "0.6.0",
  "description": "Development theatre with optional AIU inbox playlists, mixed Suno/YouTube shows, manual advance and content warnings.",
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture",
    "offscreen",
    "tabs",
    "alarms",
    "scripting",
    "identity",
    "nativeMessaging"
  ],
  "options_page": "lounge.html",
  "content_scripts": [
    {
      "matches": ["https://suno.com/*", "https://www.suno.com/*"],
      "js": ["managed-native-guard.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://suno.com/*",
        "https://www.suno.com/*"
      ],
      "js": [
        "helpers.js",
        "content.js",
        "lyric-scroll.js",
        "visual-media.js",
        "standalone.js",
        "visualizer.js",
        "broadcast-metadata.js",
        "presentation-tab-controller.js",
        "managed-player.js",
        "managed-media.js",
        "managed-show.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/aiu-logo.png",
        "lounge.html"
      ],
      "matches": [
        "https://suno.com/*",
        "https://www.suno.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; media-src https://streaming.aiu.fm; img-src 'self' data:; style-src 'self'; connect-src https: http:"
  },
  "minimum_chrome_version": "120",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "broadcast-worker.js"
  },
  "action": {
    "default_title": "Catnap Theatre — broadcast and inbox controls",
    "default_icon": {
      "16": "assets/icons/theatre-16.png",
      "32": "assets/icons/theatre-32.png",
      "48": "assets/icons/theatre-48.png",
      "128": "assets/icons/theatre-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/theatre-16.png",
    "32": "assets/icons/theatre-32.png",
    "48": "assets/icons/theatre-48.png",
    "128": "assets/icons/theatre-128.png"
  }
}
