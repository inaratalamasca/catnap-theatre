{
  "manifest_version": 3,
  "name": "Catnap Theatre for Suno — Visualizer Dev",
  "version": "0.5.0",
  "description": "Standalone Theatre with pop-out presentation controls, subtle music-reactive background bars and optional HQ audio broadcasting.",
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "options_page": "lounge.html",
  "content_scripts": [
    {
      "matches": [
        "https://suno.com/*",
        "https://www.suno.com/*"
      ],
      "js": [
        "helpers.js",
        "content.js",
        "lyric-scroll.js",
        "visual-media.js",
        "standalone.js",
        "visualizer.js",
        "broadcast-metadata.js",
        "presentation-tab-controller.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/aiu-logo.png",
        "lounge.html"
      ],
      "matches": [
        "https://suno.com/*",
        "https://www.suno.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; media-src https://streaming.aiu.fm; img-src 'self' data:; style-src 'self'; connect-src https: http:"
  },
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "broadcast-worker.js"
  },
  "action": {
    "default_title": "Catnap music broadcast"
  }
}
